{
  "name": "dsh-win-multi-bash",
  "version": "0.1.0",
  "author": "Dinosaur_MC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dinosaur-MC/dsh-win-multi-bash.git"
  },
  "description": "Windows multi-bash plugin for dsh: git_bash / wsl_bash model tools plus a shell-select executor routing the single ctx.shell seat across Git Bash, WSL and pwsh (pwsh stays the default).",
  "keywords": [
    "dsh-plugin",
    "windows",
    "bash",
    "git-bash",
    "wsl",
    "shell-select"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./shell-select": "./lib/shell-select/index.js",
    "./tool-git-bash": "./lib/tool-bash/types/git-bash.js",
    "./tool-wsl-bash": "./lib/tool-bash/types/wsl-bash.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File smoke/run.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-pwsh-local": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-pwsh-sandbox": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-bash-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-pwsh-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-pwsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
